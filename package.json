{
  "name": "crypto-analysis",
  "version": "1.0.0",
  "description": "Crypto Analysis Web Application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix frontend\" \"npm run dev:server\"",
    "dev:server": "concurrently \"tsc -w\" \"npx nodemon dist/server.js\"",
    "build": "npm run build --prefix frontend && tsc",
    "start": "node dist/server.js",
    "postinstall": "npm install --prefix frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "typescript": "^5.4.5"
  }
}
