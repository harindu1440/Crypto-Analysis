PORT=2008
NODE_ENV=
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET_HERE

# Gemini AI (Primary)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash
GEMINI_SCREENING_MODEL=gemini-3.6-flash
GEMINI_MASTER_MODEL=gemini-3.6-flash

# Groq AI
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama3-70b-8192

# OpenRouter AI
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_MODELS=openrouter/free,mistralai/mistral-7b-instruct:free

# HuggingFace AI
HF_TOKEN=YOUR_HF_TOKEN_HERE
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Multi-Model AI Settings (Phase 20.1)
AI_USAGE_MODE=free_first
AI_PROVIDER_TIMEOUT_MS=15000
AI_MAX_PARALLEL_PROVIDERS=5
AI_MIN_MODELS=2
AI_MIN_CONSENSUS_PERCENT=60
AI_MIN_CONFIDENCE=65
AI_PROVIDER_COOLDOWN_MS=300000

# Dynamic AI Router Settings (Phase 20.2)
AI_MAX_FAILOVER_ATTEMPTS=4
AI_MODEL_HEALTH_RECHECK_MS=60000
AI_RATE_LIMIT_COOLDOWN_MS=30000
AI_QUOTA_RECHECK_MS=900000
AI_MAX_PARALLEL_REQUESTS_PER_MODEL=1
AI_GEMINI_MAX_CONCURRENT=1
AI_GEMINI_RESERVED_REQUESTS=2

# Provider Priority (lower number = higher priority, availability overrides priority)
GEMINI_PRIORITY=1
GROQ_PRIORITY=2
OPENROUTER_PRIORITY=3
HUGGINGFACE_PRIORITY=4

# Phase 9: Binance Account Mode (testnet / live)
BINANCE_MODE=live
LIVE_TRADING_ENABLED=false
ACCOUNT_EQUITY_MODE=configured
ACCOUNT_SYNC_INTERVAL_MS=30000

# Phase 15: Opportunity Quality Configuration
MIN_OPPORTUNITY_SCORE=75
MIN_AI_CONFIDENCE=0.70
MIN_RISK_REWARD=1.5
MIN_AGENT_CONSENSUS=3
MAX_ANALYSIS_AGE_SECONDS=60